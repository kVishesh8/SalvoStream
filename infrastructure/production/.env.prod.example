# ==============================================================================
# SalvoStream - Stage 5 Production Environment Variables Template
#
# Copy this file to /opt/salvostream/.env on your remote VPS and fill in the values.
# Do NOT commit your active .env file containing private keys to public Git repositories!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Reverse Proxy Domain
# ------------------------------------------------------------------------------
# The fully qualified domain name (FQDN) that points to your VPS IP address.
# Highly recommended to use a subdomain such as api.yourdomain.com.
# Caddy will automatically generate and renew SSL (HTTPS) certificates for this domain.
DOMAIN=api.yourdomain.com

# ------------------------------------------------------------------------------
# 2. Prowlarr Search Pipeline
# ------------------------------------------------------------------------------
# Retrieve this key from Prowlarr Web UI: Settings -> General -> Security -> API Key.
# Connect securely via SSH tunnel (localhost:9696) to view the dashboard!
PROWLARR_API_KEY=your_prowlarr_api_key_here

# ------------------------------------------------------------------------------
# 3. FlareSolverr (Cloudflare Challenge Solver)
# ------------------------------------------------------------------------------
# Set to 'true' if you have active trackers protected by Cloudflare and want to proxy
# them through FlareSolverr. Set to 'false' otherwise.
FLARESOLVERR_ENABLED=false
FLARESOLVERR_LOG_LEVEL=info
