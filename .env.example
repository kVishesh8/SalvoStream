# SalvoStream - Stage 1 Environment Variables

# The port Fastify server will listen on
PORT=3000

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Path to SQLite database file
SQLITE_PATH=data/salvostream.db

# Node execution environment (development | production)
NODE_ENV=development

# Prowlarr Integration
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=
